<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <StartupObject>wxd.files.winforms.Program</StartupObject>
    <AssemblyTitle>wxd-gaming</AssemblyTitle>
    <Company>wxd-gaming</Company>
    <Authors>wxd-gaming</Authors>
    <PackageId>wxd-gaming</PackageId>
    <Copyright>wxd-gaming</Copyright>
    <Description>wxd-gaming</Description>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 各窗口标题栏图标：由 tools/genicons.ps1 生成，嵌入资源所以运行时不依赖磁盘文件 -->
  <ItemGroup>
    <EmbeddedResource Include="icons\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wenhao.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageReference Include="MiniExcel" Version="1.37.0" />
  </ItemGroup>

  <!-- 回归测试工程访问 internal 纯逻辑 helper（EncodeDiffCell/MergeOrderedIds/ParseGitLogOutput 等） -->
  <ItemGroup>
    <InternalsVisibleTo Include="wxd.files.winforms.RegressionTests" />
  </ItemGroup>

</Project>