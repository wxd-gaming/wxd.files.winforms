<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- 主题模式：Light, Dark -->
    <add key="ThemeMode" value="Light"/>
    <!-- 窗格数量 -->
    <add key="PaneCount" value="1"/>
    <!-- 窗格1浏览目录 -->
    <add key="Pane1Directory" value=""/>
    <!-- 窗格2浏览目录 -->
    <add key="Pane2Directory" value=""/>
    <!-- 窗格3浏览目录 -->
    <add key="Pane3Directory" value=""/>
    <!-- 窗格1过滤条件 -->
    <add key="Pane1Filter" value=""/>
    <!-- 窗格2过滤条件 -->
    <add key="Pane2Filter" value=""/>
    <!-- 窗格3过滤条件 -->
    <add key="Pane3Filter" value=""/>
    <!-- CSV查看器默认冻结行数 -->
    <add key="DefaultFrozenRows" value="2"/>
    <!-- Excel查看器默认冻结行数 -->
    <add key="ExcelDefaultFrozenRows" value="2"/>
  </appSettings>
</configuration>
