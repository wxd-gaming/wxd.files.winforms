<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- 主题模式：Light, Dark -->
    <add key="ThemeMode" value="Light"/>
    <!-- 窗格数量 -->
    <add key="PaneCount" value="7"/>
    <!-- 窗格1浏览目录 -->
    <add key="Pane1Directory" value=""/>
    <!-- 窗格2浏览目录 -->
    <add key="Pane2Directory" value=""/>
    <!-- 窗格3浏览目录 -->
    <add key="Pane3Directory" value=""/>
    <!-- 窗格1过滤条件 -->
    <add key="Pane1Filter" value=""/>
    <!-- 窗格2过滤条件 -->
    <add key="Pane2Filter" value=""/>
    <!-- 窗格3过滤条件 -->
    <add key="Pane3Filter" value=""/>
    <!-- 自定义命令列表（JSON格式） -->
    <add key="CustomCommands" value="[]"/>
  </appSettings>
</configuration>
